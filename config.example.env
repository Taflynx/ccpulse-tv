# Copy to config.env and edit. config.env is git-ignored.
SMALLTV_HOST=192.168.1.50        # your SmallTV-PRO's IP (shown on the device at boot)
WEATHER_CITY=London              # label shown on the clock screen
WEATHER_LAT=51.5074
WEATHER_LON=-0.1278
WEATHER_TZ=Europe/London         # IANA time zone
